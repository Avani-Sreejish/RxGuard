# Local development against the dev MySQL container (docker run ... -p 3307:3306). Not used in production.
export DJANGO_DEBUG=1
export DJANGO_SECRET_KEY=dev-only-not-secret
export MYSQL_HOST=127.0.0.1 MYSQL_PORT=3307 MYSQL_DATABASE=rxguard MYSQL_USER=rxguard MYSQL_PASSWORD=devpass
export DEMO_PHARMACIST_PASSWORD=rxguard-demo
export DEMO_TOGGLES_ENABLED=1
export PYTHONIOENCODING=utf-8
