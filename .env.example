# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,rxguard.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://rxguard.example.org
CORS_ALLOWED_ORIGINS=

MYSQL_DATABASE=rxguard
MYSQL_USER=rxguard
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# LLM (optional: without a key every LLM step falls back to template mode; flags are unaffected)
# "gemini-*" models use GEMINI_API_KEY, any other model ID uses ANTHROPIC_API_KEY; the chain may mix them.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash
LLM_GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_S=10
LLM_MAX_CALLS_PER_QUERY=3
LLM_MAX_INPUT_TOKENS_PER_QUERY=6000
LLM_MAX_OUTPUT_TOKENS_PER_CALL=1500
# USD per 1M tokens (input:output) - copy from the provider's current pricing page.
# Add the Gemini models you use (e.g. gemini-3.5-flash-lite=<in>:<out>); unpriced models are logged at $0
# and flagged in the eval report.
LLM_PRICES=claude-opus-5-5=4.00:20.00;claude-haiku-4-5=1.00:5.00

# Retrieval / normalisation tuning (values recorded in README)
RETRIEVAL_MIN_SCORE=0.81
# Hybrid retrieval: FAISS + BM25 fused with RRF (ranking only; RETRIEVAL_MIN_SCORE still decides)
RETRIEVAL_HYBRID=1
# Cross-encoder rerank: calibrate first (scripts/calibrate_retrieval.py --rerank), then enable
RETRIEVAL_RERANK=0
RERANK_MIN_SCORE=0.5
SUPPORT_THRESHOLD=0.6
FUZZY_AUTO=92
FUZZY_CANDIDATE=80

# Seed-time demo accounts (pharmacist + admin); leave empty to create none
DEMO_PHARMACIST_PASSWORD=
# Judge Attack failure-injection toggles (admin-only). Keep 0 in normal operation.
DEMO_TOGGLES_ENABLED=0

THROTTLE_CHECK=60/min
THROTTLE_EXPLAIN=20/min
THROTTLE_ASK=20/min
# Each worker loads the embedding model (~1.1 GB first worker, measured 1.5 GiB total for 2). Measured config: 2 x 8
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
HTTP_PORT=8080
# DOMAIN=rxguard.example.org          # for `--profile https`
# NPM_REGISTRY=https://registry.npmjs.org
